[flake8]
exclude =
    .git,
    __pycache__,
    build,
    dist,
    versioneer.py,
    nullspace/_version.py,
    docs/source/conf.py
max-line-length = 115
ignore = 
	# whitespace before ':'
	E203,
	# line break before binary operator
	W503
per-file-ignores =
	nullspace/se3.py:E241
	nullspace/rbda.py:E241
	nullspace/__init__.py:F401
